{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Invoices": "Data Source=App_Data/invoices.db"
  },
  "Import": {
    "RunOnStartup": true,
    "FilePath": "../../../data/bd_exam.json"
  },
  "BusinessCalendar": {
    "TimeZone": "America/Santiago"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Auth": {
    "Issuer": "invoices-api",
    "Audience": "invoices-web",
    "TokenLifetimeMinutes": 120
  }
}
